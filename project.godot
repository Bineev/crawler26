; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="comic_crawler"
run/main_scene="uid://u2sxbx2tb14b"
config/features=PackedStringArray("4.5", "Forward Plus")

[autoload]

DataManager="*res://scripts/global/data_manager.gd"
SignalManager="*res://scripts/global/signal_manager.gd"
SoundManager="*res://scripts/global/sound_manager.gd"
StatusInteractionManager="*res://scripts/global/status_interaction_manager.gd"
EffectExecutor="*res://scripts/global/EffectExecutor.gd"
BattleManager="*res://scripts/global/battle_manager.gd"
EnemySelector="*res://scripts/global/enemy_selector.gd"
FloorManager="*res://scripts/global/floor_manager.gd"
RoomManager="*res://scripts/global/room_manager.gd"
ProgressManager="*res://scripts/global/progress_manager.gd"
DeckManager="*res://scripts/global/deck_manager.gd"
ArtifactManager="*res://scripts/global/artifact_manager.gd"
TooltipManager="*res://scripts/global/tooltip_manager.gd"
RunManager="*res://scripts/global/run_manager.gd"
SaveManager="*res://scripts/global/save_manager.gd"
GameTestManager="*res://scripts/global/game_test_manager.gd"

[debug]

gdscript/warnings/unassigned_variable=0
gdscript/warnings/unassigned_variable_op_assign=0
gdscript/warnings/unused_variable=0
gdscript/warnings/unused_local_constant=0
gdscript/warnings/unused_private_class_variable=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/unused_signal=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/shadowed_variable_base_class=0
gdscript/warnings/shadowed_global_identifier=0
gdscript/warnings/unreachable_code=0
gdscript/warnings/unreachable_pattern=0
gdscript/warnings/standalone_expression=0
gdscript/warnings/standalone_ternary=0
gdscript/warnings/incompatible_ternary=0
gdscript/warnings/unsafe_void_return=0
gdscript/warnings/static_called_on_instance=0
gdscript/warnings/missing_tool=0
gdscript/warnings/redundant_static_unload=0
gdscript/warnings/redundant_await=0
gdscript/warnings/assert_always_true=0
gdscript/warnings/assert_always_false=0
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0
gdscript/warnings/int_as_enum_without_cast=0
gdscript/warnings/int_as_enum_without_match=0
gdscript/warnings/enum_variable_without_default=0
gdscript/warnings/empty_file=0
gdscript/warnings/deprecated_keyword=0
gdscript/warnings/confusable_identifier=0
gdscript/warnings/confusable_local_declaration=0
gdscript/warnings/confusable_local_usage=0
gdscript/warnings/confusable_capture_reassignment=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=4
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[input]

options={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":79,"key_label":0,"unicode":111,"location":0,"echo":false,"script":null)
